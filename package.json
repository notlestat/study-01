{
  "name": "study-01",
  "version": "0.2.0",
  "description": "A composition instrument for exploring visual systems",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "benchmark:baseline": "node scripts/render-benchmark.mjs baseline",
    "benchmark:current": "node scripts/render-benchmark.mjs current && node scripts/compare-benchmark.mjs",
    "benchmark:direct": "node scripts/render-direct-review.mjs",
    "benchmark:space": "node scripts/render-benchmark.mjs space && node scripts/compare-space.mjs",
    "benchmark:image-type": "node scripts/render-image-type-review.mjs",
    "benchmark:crossbreed": "node scripts/render-crossbreed-review.mjs",
    "benchmark:accident": "node scripts/render-accident-review.mjs",
    "benchmark:typography": "node scripts/render-typography-review.mjs",
    "benchmark:family": "node scripts/render-family-review.mjs",
    "benchmark:drift": "node scripts/render-drift-review.mjs",
    "benchmark:colour": "node scripts/render-colour-review.mjs"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "rolldown": "^1.2.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true
}
